# ===== Supabase =====
# من: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# مفتاح الخدمة — يتجاوز RLS. لا يُعرض للمتصفح إطلاقاً.
# يُستخدم في: مصادقة مسؤولي المسح، ويب-هوك الدفع، لوحة الأدمن.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ===== أسرار الجلسات =====
# ٣٢ حرفاً على الأقل لكل واحد. ولّدها بـ: openssl rand -base64 48
SCANNER_SESSION_SECRET=
ADMIN_SESSION_SECRET=

# ===== الموقع =====
# يُستخدم في روابط رجوع الدفع وتأكيد البريد. بدونه نستنتجه من الطلب.
NEXT_PUBLIC_SITE_URL=https://pkgat.com

# ===== بوابة الدفع مُيسّر (Moyasar) =====
# من: لوحة مُيسّر → Settings → API Keys
# اتركها فارغة أثناء التطوير — تعمل المنصة بدون دفع مع تعطيل أزرار الشراء.
MOYASAR_SECRET_KEY=
# الرمز السرّي للويب-هوك (تضبطه أنت في لوحة مُيسّر عند إنشاء الويب-هوك)
MOYASAR_WEBHOOK_SECRET=

# ===== البريد (Resend) =====
# مطلوب لتذكير ما قبل المناسبة. بدونه يعمل الموقع لكن لا تُرسل تذكيرات.
# من: resend.com → API Keys
# عنوان الردّ — صندوق يقرؤه بشر. بدونه يضيع ردّ العميل على رسالة التفعيل.
EMAIL_REPLY_TO=hello@pkgat.com

RESEND_API_KEY=
# لا بد أن يكون نطاقاً موثّقاً في Resend — مثال: بكجات <no-reply@pkgat.com>
EMAIL_FROM=

# ===== مهمة التذكير المجدولة =====
# يولّده Vercel تلقائياً عند إضافة Cron، أو ولّده بـ: openssl rand -base64 32
CRON_SECRET=
